# Default: GPT-6 Astra with medium reasoning through local ChatGPT OAuth.
# Run .\oauth.ps1 setup once. No OpenAI API key is needed.
AI_PROVIDER=openai_oauth

# Optional rollback: set AI_PROVIDER=ollama to use these existing settings.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gemma4:31b-cloud
