*.WAV
*.mp4
*.mov
reel *.txt

# Episode data: transcripts, waveform scans, speaker turns and embeddings.
# This is client material and it is large. Everything here regenerates from the
# source media.
cache/

# Diarization models, ~107 MB, fetched by engine/models.py on first run.
models/

# Local archives and generated preview images.
backups/
previews/

# Generated export presets (engine/preset.py rebuilds them per export).
presets/

